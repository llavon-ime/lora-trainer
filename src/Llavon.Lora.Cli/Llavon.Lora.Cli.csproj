<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>llavon-lora</AssemblyName>
    <Version Condition="'$(Version)' == ''">0.0.0.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <TorchBackend Condition="'$(TorchBackend)' == ''">cpu</TorchBackend>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Llavon.Lora.Core\Llavon.Lora.Core.csproj" />
    <PackageReference Include="TorchSharp-cpu" Version="$(TorchSharpVersion)" Condition="'$(TorchBackend)' == 'cpu'" />
    <PackageReference Include="TorchSharp-cuda-windows" Version="$(TorchSharpVersion)" Condition="'$(TorchBackend)' == 'cuda-windows'" />
    <PackageReference Include="TorchSharp-cuda-linux" Version="$(TorchSharpVersion)" Condition="'$(TorchBackend)' == 'cuda-linux'" />
  </ItemGroup>

  <Target Name="ValidateTorchBackend" BeforeTargets="Restore;Build">
    <Error Condition="'$(TorchBackend)' != 'cpu' and '$(TorchBackend)' != 'cuda-windows' and '$(TorchBackend)' != 'cuda-linux'"
           Text="TorchBackend must be cpu, cuda-windows, or cuda-linux." />
  </Target>
</Project>
